{
  "name": "digital-damage-reporting-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply damage-reporting --local",
    "db:seed:local": "wrangler d1 execute damage-reporting --local --file=seed/seed.sql",
    "db:simulate:deactivate-product:local": "wrangler d1 execute damage-reporting --local --file=seed/deactivate-product.sql",
    "db:simulate:reactivate-product:local": "wrangler d1 execute damage-reporting --local --file=seed/reactivate-product.sql",
    "test": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --outDir .test-build src/lib/workflow-policy.ts && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.28.1"
  }
}
