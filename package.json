{
  "name": "digital-damage-reporting-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/seed.sql",
    "db:simulate:deactivate-product:local": "wrangler d1 execute DB --local --file=seed/deactivate-product.sql",
    "db:simulate:reactivate-product:local": "wrangler d1 execute DB --local --file=seed/reactivate-product.sql",
    "test": "npm run test:unit && npm run test:workers",
    "test:unit": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --rootDir src --outDir .test-build src/lib/workflow-policy.ts src/domain/roles.ts && node --test test/*.test.mjs",
    "test:workers": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.28.1"
  }
}
