{
  "name": "digital-damage-reporting-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && npm run deploy:worker",
    "deploy:worker": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=seed/seed.sql",
    "db:simulate:deactivate-product:local": "wrangler d1 execute DB --local --file=seed/deactivate-product.sql",
    "db:simulate:reactivate-product:local": "wrangler d1 execute DB --local --file=seed/reactivate-product.sql",
    "test": "npm run test:unit && npm run test:workers",
    "test:unit": "tsc --target ES2022 --module ESNext --moduleResolution Bundler --rootDir src --outDir .test-build src/lib/http.ts src/lib/workflow-policy.ts src/lib/submission-input.ts src/domain/roles.ts && node --test test/*.test.mjs",
    "test:workers": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "logs:tail": "wrangler tail --format json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.28.1"
  }
}
